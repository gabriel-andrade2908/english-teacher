# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Anthropic API key (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=

# Random secret used to sign the login cookie (at least 16 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Invite codes, one per tester: name:code, separated by commas. Use long random codes.
# Leave empty to skip the login in "npm run dev" (local mode). Production always requires codes.
ACCESS_CODES=gabriel:change-me-to-a-long-random-code

# Messages per tester per day (default 30; 0 = no limit)
DAILY_MESSAGE_LIMIT=30

# Models per feature (default claude-opus-5 for all)
# TUTOR_MODEL=claude-opus-5
# ANALYZER_MODEL=claude-opus-5
# TRANSLATOR_MODEL=claude-opus-5

# Testing with a free local model instead of Claude: install Ollama (ollama.com),
# run "ollama pull qwen3:8b", then set AI_PROVIDER=ollama (automatic when ANTHROPIC_API_KEY is empty).
# AI_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:8b
